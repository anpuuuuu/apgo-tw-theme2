{{ 'apgo-home-v2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bestseller_count = 0
  for block in section.blocks
    if block.settings.product != blank and block.settings.product.available
      assign bestseller_count = bestseller_count | plus: 1
    endif
  endfor
-%}

{%- if bestseller_count > 0 or request.design_mode -%}
  <section
    class="apgo-home-module apgo-home-bestsellers"
    data-apgo-home-bestsellers
    style="--apgo-home-accent: {{ section.settings.accent_color }}; --apgo-home-max: {{ section.settings.max_width }}px; --apgo-home-padding-top: {{ section.settings.padding_top }}px; --apgo-home-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="apgo-home-v2__inner">
      <div class="apgo-home-panel">
        <header class="apgo-home-heading">
          <div>
            <p class="apgo-home-heading__eyebrow">BEST SELLERS</p>
            <h2 id="ApgoBestsellers-{{ section.id }}">{{ section.settings.title }}</h2>
          </div>
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}">{{ section.settings.view_all_label }}</a>
          {%- endif -%}
        </header>

        {%- if bestseller_count > 0 -%}
          <div class="apgo-home-scroller-wrap">
            <button class="apgo-home-scroll-button apgo-home-scroll-button--prev" type="button" data-apgo-scroll-prev aria-label="往左瀏覽">‹</button>
            <div class="apgo-home-product-row" data-apgo-scroll>
              {%- for block in section.blocks -%}
                {%- assign selected_product = block.settings.product -%}
                {%- if selected_product == blank or selected_product.available == false -%}{%- continue -%}{%- endif -%}
                <div class="apgo-home-product-row__item" {{ block.shopify_attributes }}>
                  {% render 'apgo-home-product-card', product: selected_product, show_add: true %}
                </div>
              {%- endfor -%}
            </div>
            <button class="apgo-home-scroll-button apgo-home-scroll-button--next" type="button" data-apgo-scroll-next aria-label="往右瀏覽">›</button>
          </div>
        {%- else -%}
          <p class="apgo-home-empty">請新增商品區塊並選擇商品；缺貨商品會自動隱藏。</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-apgo-home-bestsellers]');
    if (!root || root.dataset.apgoHomeReady) return;
    root.dataset.apgoHomeReady = 'true';
    const scroller = root.querySelector('[data-apgo-scroll]');
    if (!scroller) return;
    root.querySelector('[data-apgo-scroll-prev]')?.addEventListener('click', () => {
      scroller.scrollBy({ left: -Math.max(scroller.clientWidth * 0.75, 280), behavior: 'smooth' });
    });
    root.querySelector('[data-apgo-scroll-next]')?.addEventListener('click', () => {
      scroller.scrollBy({ left: Math.max(scroller.clientWidth * 0.75, 280), behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "APGO · 熱銷商品 v2",
  "tag": "section",
  "class": "apgo-home-bestsellers-section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "title", "label": "標題", "default": "熱銷商品" },
    { "type": "url", "id": "link", "label": "查看全部連結" },
    { "type": "text", "id": "view_all_label", "label": "查看全部文字", "default": "查看全部" },
    { "type": "range", "id": "max_width", "label": "內容最大寬度", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "color", "id": "accent_color", "label": "品牌強調色", "default": "#f58220" },
    { "type": "range", "id": "padding_top", "label": "上方留白", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "下方留白", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "熱銷商品",
      "settings": [
        { "type": "product", "id": "product", "label": "商品", "info": "缺貨或下架時會自動隱藏。" }
      ]
    }
  ],
  "presets": [
    {
      "name": "APGO · 熱銷商品 v2",
      "blocks": [
        { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }
      ]
    }
  ],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
