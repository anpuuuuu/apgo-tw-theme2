{% comment %}
  APGO Tactical Hub v2.4 - Shopify Liquid Version
  遵循 APGO Design System: Dark Tech Minimalist v2.0 規範
  更新：移除 Emoji，全面替換為精緻 Tactical SVG 圖示，保留拖曳與層級修正。
{% endcomment %}

<div id="apgo-hub-{{ section.id }}" class="apgo-widget-container" style="--widget-bottom: {{ section.settings.bottom_offset }}px;">
  <!-- 背景遮罩 (手機版專用) -->
  <div class="hub-overlay" onclick="toggleApgoHub()"></div>

  <!-- 戰術選單面板 (Z-index 確保在按鈕上方) -->
  <div id="apgo-hub-panel" class="hub-panel">
    <div class="panel-inner">
      <div class="panel-header">
        <span class="card-label">// {{ section.settings.panel_title | default: 'COMMS_CENTRAL' }}</span>
        <div class="status-pill">
          <div class="status-dot"></div>
          ONLINE
        </div>
      </div>

      <div class="bento-grid">
        {% for block in section.blocks %}
          {% if block.type == 'link' %}
            <a href="{{ block.settings.url }}" 
               class="bento-item {% if block.settings.is_primary %}item-primary{% endif %}" 
               {{ block.shopify_attributes }}
               onclick="handleTacticalClick()">
              
              <div class="item-icon" style="width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px;">
                {% if block.settings.icon_svg != blank %}
                  {{ block.settings.icon_svg }}
                {% else %}
                  <span style="font-size: {{ block.settings.icon_size }}px;">{{ block.settings.icon_emoji }}</span>
                {% endif %}
              </div>

              <div class="item-text">
                <span class="item-title">{{ block.settings.title | upcase }}</span>
                <span class="item-sub">{{ block.settings.subtitle }}</span>
              </div>

              {% if block.settings.is_primary %}
                <div class="scan-line"></div>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 浮動觸發按鈕 (+ 圖示) -->
  <button id="apgo-trigger" class="hub-trigger" aria-label="Toggle Hub">
    <div class="trigger-ring"></div>
    <div class="trigger-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </div>
  </button>
</div>

<style>
/* --- APGO 2.0 CSS Variables --- */
#apgo-hub-{{ section.id }} {
  --dt-bg-screen: #050505;
  --dt-bg-surface: #121212;
  --dt-bg-input: #1a1a1a;
  --dt-signal-orange: #f08418;
  --dt-signal-glow: rgba(240, 132, 24, 0.4);
  --dt-text-secondary: #999999;
  --dt-border: #333333;
  --dt-radius: 12px;
  --font-mono: "SF Mono", "Menlo", "Courier New", monospace;
  
  position: fixed;
  right: 12px;
  bottom: var(--widget-bottom);
  z-index: 9999;
  font-family: var(--font-mono);
  touch-action: none;
}

/* Slides to the nearest edge after a drag (see the script below). */
#apgo-hub-{{ section.id }}.is-snapping {
  transition: left 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), bottom 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}
/* Docked on the left: open the menu toward the right. */
#apgo-hub-{{ section.id }}.is-left .hub-panel {
  right: auto;
  left: 0;
}

/* 觸發按鈕 */
.hub-trigger {
  width: 60px;
  height: 60px;
  background: var(--dt-bg-surface);
  border: 1px solid var(--dt-border);
  border-radius: 50%;
  cursor: grab;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dt-signal-orange);
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  z-index: 10;
  outline: none;
  user-select: none;
}

.hub-trigger:active { cursor: grabbing; transform: scale(0.95); }

.trigger-icon svg {
  width: 26px;
  height: 26px;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.is-open .trigger-icon svg {
  transform: rotate(135deg);
}

.trigger-ring {
  position: absolute;
  top: -1px; left: -1px; right: -1px; bottom: -1px;
  border: 1px solid var(--dt-signal-orange);
  border-radius: 50%;
  animation: hub-pulse 2s infinite;
  pointer-events: none;
}

@keyframes hub-pulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.5); opacity: 0; }
}

/* 面板與 Bento 佈局 */
.hub-panel {
  position: absolute;
  bottom: 80px;
  right: 0;
  width: 300px;
  background: var(--dt-bg-surface);
  border: 1px solid var(--dt-border);
  border-radius: var(--dt-radius);
  display: none;
  backdrop-filter: blur(12px);
  animation: panel-pop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 10px 40px rgba(0,0,0,0.8);
  z-index: 20; 
}

@keyframes panel-pop {
  from { opacity: 0; transform: translateY(10px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.panel-header {
  padding: 12px 16px;
  border-bottom: 1px solid var(--dt-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-label { font-size: 10px; color: var(--dt-text-secondary); letter-spacing: 1px; }

.status-pill {
  display: flex; align-items: center; gap: 6px; font-size: 9px; color: #00ff00;
}

.status-dot {
  width: 5px; height: 5px; background: #00ff00; border-radius: 50%;
  box-shadow: 0 0 8px #00ff00;
  animation: blink 1.5s infinite;
}

@keyframes blink { 50% { opacity: 0.3; } }

.bento-grid { padding: 12px; display: grid; gap: 10px; }

.bento-item {
  background: var(--dt-bg-input);
  border: 1px solid var(--dt-border);
  border-radius: 8px;
  padding: 14px;
  text-decoration: none;
  color: #fff;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}

.item-primary { border-color: var(--dt-signal-orange); }

.item-icon { margin-right: 14px; display: flex; align-items: center; justify-content: center; color: var(--dt-signal-orange); }
.item-icon svg { width: 100%; height: auto; }

.item-title { display: block; font-size: 13px; font-weight: 800; letter-spacing: 0.5px; }
.item-sub { display: block; font-size: 10px; color: var(--dt-text-secondary); margin-top: 2px; }

.scan-line {
  position: absolute;
  top: 0; left: -100%; width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(240, 132, 24, 0.15), transparent);
  animation: apgo-scan 3s infinite;
}

@keyframes apgo-scan {
  0% { left: -100%; }
  100% { left: 150%; }
}

@media (max-width: 768px) {
  .hub-panel {
    position: fixed;
    bottom: 0; left: 0; right: 0; width: 100%;
    border-radius: var(--dt-radius) var(--dt-radius) 0 0;
    border-bottom: none;
    z-index: 10001;
  }
  .hub-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    z-index: 10000;
  }
  .is-open .hub-overlay { display: block; }
}
</style>

<script>
(function() {
    const container = document.getElementById('apgo-hub-{{ section.id }}');
    const trigger = document.getElementById('apgo-trigger');
    const panel = document.getElementById('apgo-hub-panel');
    if (!container || !trigger || !panel) return;

    // The button can be dragged anywhere; on release it slides to the nearest
    // left or right edge and remembers that spot for the next page. The
    // survey gift (apgo-survey) sits above it and follows every move through
    // the 'apgo:hub-move' event, and can start a drag through window.apgoHub.
    const EDGE = 12;          // gap to the screen edge after snapping
    const TOP_GAP = 90;       // keep clear of the header
    const STORE_KEY = 'apgo-hub-pos';
    const THRESHOLD = 5;      // px of movement before a press counts as a drag

    window.toggleApgoHub = function() {
        const isVisible = panel.style.display === 'block';
        if (navigator.vibrate) navigator.vibrate(10);

        if (isVisible) {
            panel.style.display = 'none';
            container.classList.remove('is-open');
        } else {
            panel.style.display = 'block';
            container.classList.add('is-open');
        }
    };

    window.handleTacticalClick = function() {
        if (navigator.vibrate) navigator.vibrate(15);
    };

    function giftRoom() {
        return document.querySelector('[data-apgo-sv-launcher]') ? 90 : 0;
    }
    function clampBottom(bottom) {
        const max = Math.max(EDGE, window.innerHeight - container.offsetHeight - TOP_GAP - giftRoom());
        return Math.min(Math.max(EDGE, bottom), max);
    }
    function emit(dragging) {
        window.dispatchEvent(new CustomEvent('apgo:hub-move', { detail: { dragging: !!dragging } }));
    }
    function currentSide() {
        return container.classList.contains('is-left') ? 'left' : 'right';
    }
    function pin(side, bottom) {
        container.style.bottom = clampBottom(bottom) + 'px';
        if (side === 'left') {
            container.style.left = EDGE + 'px';
            container.style.right = 'auto';
        } else {
            container.style.right = EDGE + 'px';
            container.style.left = 'auto';
        }
        container.classList.toggle('is-left', side === 'left');
    }
    function save(side, bottom) {
        try { localStorage.setItem(STORE_KEY, JSON.stringify({ side: side, bottom: bottom })); } catch (e) {}
    }

    // Put the button back where the shopper left it.
    (function restore() {
        let saved = null;
        try { saved = JSON.parse(localStorage.getItem(STORE_KEY) || 'null'); } catch (e) {}
        const fallback = parseFloat(getComputedStyle(container).bottom) || 24;
        const bottom = saved && typeof saved.bottom === 'number' ? saved.bottom : fallback;
        pin(saved && saved.side === 'left' ? 'left' : 'right', bottom);
        emit(false);
    })();

    let drag = null;

    function beginDrag(e, onTap) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        drag = {
            id: e.pointerId,
            startX: e.clientX,
            startY: e.clientY,
            left: container.getBoundingClientRect().left,
            bottom: parseFloat(getComputedStyle(container).bottom) || 0,
            moved: false,
            onTap: onTap
        };
        container.classList.remove('is-snapping');
        window.addEventListener('pointermove', moveDrag, { passive: false });
        window.addEventListener('pointerup', endDrag);
        window.addEventListener('pointercancel', endDrag);
    }

    function moveDrag(e) {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.startX;
        const dy = e.clientY - drag.startY;
        if (!drag.moved && Math.abs(dx) < THRESHOLD && Math.abs(dy) < THRESHOLD) return;
        drag.moved = true;
        if (e.cancelable) e.preventDefault();
        const width = container.offsetWidth;
        const left = Math.min(Math.max(EDGE, drag.left + dx), window.innerWidth - width - EDGE);
        container.style.left = left + 'px';
        container.style.right = 'auto';
        container.style.bottom = clampBottom(drag.bottom - dy) + 'px';
        container.classList.toggle('is-left', left + width / 2 < window.innerWidth / 2);
        emit(true);
    }

    function endDrag(e) {
        if (!drag || (e && e.pointerId !== undefined && e.pointerId !== drag.id)) return;
        window.removeEventListener('pointermove', moveDrag);
        window.removeEventListener('pointerup', endDrag);
        window.removeEventListener('pointercancel', endDrag);
        const done = drag;
        drag = null;

        if (!done.moved) {
            if (done.onTap && e && e.type === 'pointerup') done.onTap();
            return;
        }

        // Tell tap handlers to ignore the click that follows a drag.
        window.__apgoHubDraggedAt = Date.now();

        const width = container.offsetWidth;
        const rect = container.getBoundingClientRect();
        const side = rect.left + width / 2 < window.innerWidth / 2 ? 'left' : 'right';
        const bottom = clampBottom(parseFloat(container.style.bottom) || 0);

        // Slide to the edge, letting the gift follow frame by frame,
        // then pin with left/right so a resize keeps it on that edge.
        container.classList.add('is-snapping');
        container.style.left = (side === 'left' ? EDGE : window.innerWidth - width - EDGE) + 'px';
        const until = Date.now() + 320;
        (function follow() {
            emit(true);
            if (Date.now() < until) requestAnimationFrame(follow);
        })();
        setTimeout(function () {
            // Land exactly on the edge even if the slide was held back
            // (e.g. the tab was in the background).
            if (container.getAnimations) container.getAnimations().forEach(function (a) { a.finish(); });
            container.classList.remove('is-snapping');
            pin(side, bottom);
            save(side, bottom);
            emit(false);
        }, 320);
    }

    trigger.addEventListener('pointerdown', function (e) { beginDrag(e, window.toggleApgoHub); });
    // Keyboard presses arrive as clicks with no pointer behind them.
    trigger.addEventListener('click', function (e) {
        if (e.detail === 0) window.toggleApgoHub();
    });

    window.addEventListener('resize', function () {
        if (drag) return;
        pin(currentSide(), parseFloat(container.style.bottom) || 0);
        emit(false);
    });

    window.apgoHub = { beginDrag: beginDrag };

    document.addEventListener('click', function(e) {
        if (container && !container.contains(e.target)) {
            panel.style.display = 'none';
            container.classList.remove('is-open');
        }
    });
})();
</script>

{% schema %}
{
  "name": "APGO Tactical Hub",
  "settings": [
    {
      "type": "text",
      "id": "panel_title",
      "label": "面板標籤 (// LABEL)",
      "default": "COMMS_CENTRAL"
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "小工具初始底部偏移量",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "戰術連結區塊",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_primary",
          "label": "設為主要連結 (橘框+掃描線)",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "連結標題",
          "default": "ESTABLISH COMMS"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "副標題/狀態描述",
          "default": "連線至 LINE 客服"
        },
        {
          "type": "url",
          "id": "url",
          "label": "跳轉連結"
        },
        {
          "type": "header",
          "content": "圖示設定"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG 代碼 (建議使用)",
          "info": "將 SVG 代碼貼在此處，將會覆蓋 Emoji。"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "或使用 Emoji 圖示",
          "default": "💬"
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 12,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "圖示寬度/高度",
          "default": 24
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "APGO Tactical Hub",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "title": "ESTABLISH COMMS",
            "subtitle": "連線至 LINE 技術支援",
            "is_primary": true,
            "icon_svg": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'></path></svg>"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "TRACK_MISSION",
            "subtitle": "訂單物流進度查詢",
            "icon_svg": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z'></path><path d='m3.3 7 8.7 5 8.7-5'></path><path d='M12 22V12'></path></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}