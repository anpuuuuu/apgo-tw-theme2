{{ 'apgo-home-v2.css' | asset_url | stylesheet_tag }}

{%- assign featured_product = section.settings.featured_product -%}
{%- assign new_collection = section.settings.collection -%}

{%- if featured_product != blank or new_collection != blank or request.design_mode -%}
  <section
    class="apgo-home-module apgo-home-new"
    style="--apgo-home-accent: {{ section.settings.accent_color }}; --apgo-home-max: {{ section.settings.max_width }}px; --apgo-home-padding-top: {{ section.settings.padding_top }}px; --apgo-home-padding-bottom: {{ section.settings.padding_bottom }}px;"
    aria-labelledby="ApgoNew-{{ section.id }}"
  >
    <div class="apgo-home-v2__inner">
      <div class="apgo-home-panel">
        <header class="apgo-home-heading">
          <div>
            <p class="apgo-home-heading__eyebrow">NEW ARRIVALS</p>
            <h2 id="ApgoNew-{{ section.id }}">{{ section.settings.title }}</h2>
          </div>
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}">{{ section.settings.view_all_label }}</a>
          {%- elsif new_collection != blank -%}
            <a href="{{ new_collection.url }}">{{ section.settings.view_all_label }}</a>
          {%- endif -%}
        </header>

        {%- if featured_product != blank -%}
          <div class="apgo-home-new__grid">
            <article class="apgo-home-new__feature">
              <a href="{{ featured_product.url }}" class="apgo-home-new__feature-link">
                <span class="apgo-home-card__badge">NEW</span>
                <div class="apgo-home-new__feature-media">
                  {%- if featured_product.featured_image != blank -%}
                    {{ featured_product.featured_image
                      | image_url: width: 1100
                      | image_tag: class: 'apgo-home-new__feature-image', widths: '480,720,960,1100', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'apgo-home-new__feature-image apgo-home-card__placeholder' }}
                  {%- endif -%}
                </div>
                <div class="apgo-home-new__feature-content">
                  <h3>{{ featured_product.title }}</h3>
                  {%- if section.settings.feature_copy != blank -%}<p>{{ section.settings.feature_copy }}</p>{%- endif -%}
                  <span class="apgo-home-new__cta">{{ section.settings.learn_more_label }}</span>
                </div>
              </a>
            </article>

            <div class="apgo-home-new__secondary">
              {%- assign secondary_count = 0 -%}
              {%- if new_collection != blank -%}
                {%- for product in new_collection.products -%}
                  {%- if product.id == featured_product.id -%}{%- continue -%}{%- endif -%}
                  {%- if secondary_count >= 4 -%}{%- break -%}{%- endif -%}
                  <div class="apgo-home-new__secondary-card">
                    {% render 'apgo-home-product-card', product: product, show_add: false, badge: 'NEW' %}
                  </div>
                  {%- assign secondary_count = secondary_count | plus: 1 -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if secondary_count == 0 and request.design_mode -%}
                <p class="apgo-home-empty">選擇新品系列後，這裡會顯示四件副卡商品。</p>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <p class="apgo-home-empty">請選擇一件「主打新品」。</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "APGO · 主打新品 v2",
  "tag": "section",
  "class": "apgo-home-new-section",
  "settings": [
    { "type": "text", "id": "title", "label": "標題", "default": "主打新品・新上市" },
    { "type": "product", "id": "featured_product", "label": "主打新品" },
    { "type": "collection", "id": "collection", "label": "新品系列（副卡取前四件）" },
    { "type": "textarea", "id": "feature_copy", "label": "主打新品短文", "default": "新品特色一句話說明，建議手機版控制在二十字以內。" },
    { "type": "url", "id": "link", "label": "查看全部連結（選填）" },
    { "type": "text", "id": "view_all_label", "label": "查看全部文字", "default": "查看全部" },
    { "type": "text", "id": "learn_more_label", "label": "主卡按鈕文字", "default": "看更多" },
    { "type": "range", "id": "max_width", "label": "內容最大寬度", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "color", "id": "accent_color", "label": "品牌強調色", "default": "#f58220" },
    { "type": "range", "id": "padding_top", "label": "上方留白", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "下方留白", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "APGO · 主打新品 v2" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
