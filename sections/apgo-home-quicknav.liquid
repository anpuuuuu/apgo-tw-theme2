{%- comment -%}
  APGO · 圖示選單
  A row of round icons with labels, each linking somewhere. Put it right
  below the banner carousel; it rises into the banner's bottom edge by the
  "overlap" amount. When the icons don't fit, the row scrolls sideways
  (swipe on phones, arrow buttons on computers).

  Each item shows its uploaded image, or one of the built-in icons in
  assets/apgo-qn-*.webp when no image is uploaded.

  The overlap is also published as --apgo-qn-overlap so the banner's dots
  can sit above the part that gets covered.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign overlap = s.overlap | default: 0
  assign overlap_m = s.overlap_mobile | default: 0
-%}

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: var(--layer-heightened, 4);
    margin-top: -{{ overlap }}px;
  }
  :root { --apgo-qn-overlap: {{ overlap }}px; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { margin-top: -{{ overlap_m }}px; }
    :root { --apgo-qn-overlap: {{ overlap_m }}px; }
  }
</style>

{%- if section.blocks.size > 0 -%}
  <nav
    class="apgo-qn{% if s.crop_circle %} apgo-qn--crop{% endif %}"
    data-apgo-qn
    aria-label="{{ s.aria_label | default: '商品分類' | escape }}"
    style="
      --qn-maxw: {{ s.max_width }}px;
      --qn-pad: {{ s.side_padding }}px;
      --qn-pad-m: {{ s.side_padding_mobile }}px;
      --qn-gap-bottom: {{ s.gap_bottom }}px;
      --qn-gap-bottom-m: {{ s.gap_bottom_mobile }}px;
      --qn-bg: {{ s.card_bg }};
      --qn-border: {{ s.card_border }};
      --qn-text: {{ s.text_color }};
      --qn-hover: {{ s.hover_color }};
      --qn-icon: {{ s.icon_size }}px;
      --qn-icon-m: {{ s.icon_size_mobile }}px;
      --qn-per-row-m: {{ s.per_row_mobile }};
    "
  >
    <div class="apgo-qn__card">
      <button type="button" class="apgo-qn__arrow apgo-qn__arrow--prev" data-qn-prev aria-label="往左看更多" tabindex="-1">‹</button>
      <ul class="apgo-qn__list" data-qn-list role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign icon_src = blank
            if b.image != blank
              assign icon_src = b.image | image_url: width: 256
              assign icon_srcset = b.image | image_url: width: 128 | append: ' 128w, ' | append: icon_src | append: ' 256w'
            elsif b.builtin != 'none'
              assign icon_file = 'apgo-qn-' | append: b.builtin | append: '.webp'
              assign icon_src = icon_file | asset_url
              assign icon_srcset = blank
            endif
          -%}
          <li class="apgo-qn__item" {{ block.shopify_attributes }}>
            {%- if b.link != blank -%}<a class="apgo-qn__link" href="{{ b.link }}">{%- else -%}<div class="apgo-qn__link">{%- endif -%}
              <span class="apgo-qn__icon" aria-hidden="true">
                {%- if icon_src != blank -%}
                  <img
                    src="{{ icon_src }}"
                    {% if icon_srcset != blank %}srcset="{{ icon_srcset }}" sizes="{{ s.icon_size }}px"{% endif %}
                    alt=""
                    width="256"
                    height="256"
                    loading="eager"
                    decoding="async"
                    draggable="false"
                  >
                {%- endif -%}
              </span>
              <span class="apgo-qn__label">{{ b.label | escape }}</span>
            {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="apgo-qn__arrow apgo-qn__arrow--next" data-qn-next aria-label="往右看更多" tabindex="-1">›</button>
    </div>
  </nav>

  <script>
    (function () {
      function init(root) {
        if (!root || root.dataset.qnReady) return;
        root.dataset.qnReady = '1';
        var list = root.querySelector('[data-qn-list]');
        var prev = root.querySelector('[data-qn-prev]');
        var next = root.querySelector('[data-qn-next]');
        if (!list) return;

        function update() {
          var max = list.scrollWidth - list.clientWidth;
          var over = max > 2;
          root.classList.toggle('is-overflowing', over);
          if (prev) prev.disabled = !over || list.scrollLeft <= 2;
          if (next) next.disabled = !over || list.scrollLeft >= max - 2;
        }
        function step(dir) {
          list.scrollBy({ left: dir * Math.max(120, list.clientWidth * 0.7), behavior: 'smooth' });
        }
        if (prev) prev.addEventListener('click', function () { step(-1); });
        if (next) next.addEventListener('click', function () { step(1); });
        list.addEventListener('scroll', update, { passive: true });
        if ('ResizeObserver' in window) new ResizeObserver(update).observe(list);
        else window.addEventListener('resize', update);
        update();
      }
      function initAll() {
        document.querySelectorAll('[data-apgo-qn]').forEach(init);
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
      else initAll();
      document.addEventListener('shopify:section:load', function (e) {
        init(e.target.querySelector('[data-apgo-qn]'));
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .apgo-qn {
    position: relative;
    padding: 0 var(--qn-pad, 16px);
    margin-bottom: var(--qn-gap-bottom, 24px);
    box-sizing: border-box;
  }
  .apgo-qn__card {
    position: relative;
    max-width: var(--qn-maxw, 1440px);
    margin: 0 auto;
    padding: 20px 16px 16px;
    background: var(--qn-bg, #17191d);
    border: 1px solid var(--qn-border, #2a2d33);
    border-radius: 22px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    box-sizing: border-box;
  }
  .apgo-qn__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(calc(var(--qn-icon, 76px) + 44px), 1fr);
    gap: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .apgo-qn__list::-webkit-scrollbar { display: none; }
  .apgo-qn__item {
    min-width: 0;
    scroll-snap-align: start;
  }
  .apgo-qn__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 4px 2px 2px;
    color: var(--qn-text, #e9e9ec);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .apgo-qn__icon {
    position: relative;
    display: block;
    flex: none;
    width: var(--qn-icon, 76px);
    height: var(--qn-icon, 76px);
    border-radius: 50%;
    overflow: hidden;
    background: #e4ebf5;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .apgo-qn__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* The supplied icons are a light circle on a square white tile; zooming in
     a little trims the tile's corners so only the circle shows. */
  .apgo-qn--crop .apgo-qn__icon img { transform: scale(1.12); }
  .apgo-qn__label {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-align: center;
    transition: color 0.2s ease;
  }
  .apgo-qn__link:focus-visible {
    outline: 2px solid var(--qn-hover, #f08418);
    outline-offset: 4px;
    border-radius: 12px;
  }
  @media (hover: hover) {
    a.apgo-qn__link:hover .apgo-qn__icon {
      transform: translateY(-3px);
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.36);
    }
    a.apgo-qn__link:hover .apgo-qn__label { color: var(--qn-hover, #f08418); }
  }

  /* Arrow buttons: computers only, and only while the row overflows. */
  .apgo-qn__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 34px;
    height: 34px;
    padding: 0 0 3px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(12, 13, 15, 0.85);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .apgo-qn__arrow--prev { left: -12px; }
  .apgo-qn__arrow--next { right: -12px; }
  .apgo-qn__arrow:hover {
    background: var(--qn-hover, #f08418);
    border-color: var(--qn-hover, #f08418);
  }
  .apgo-qn__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }
  @media (hover: hover) and (min-width: 750px) {
    .apgo-qn.is-overflowing .apgo-qn__arrow {
      display: grid;
      place-items: center;
    }
  }

  @media (max-width: 749px) {
    .apgo-qn {
      padding: 0 var(--qn-pad-m, 12px);
      margin-bottom: var(--qn-gap-bottom-m, 16px);
    }
    .apgo-qn__card {
      padding: 14px 6px 12px;
      border-radius: 18px;
    }
    .apgo-qn__list {
      gap: 4px;
      grid-auto-columns: calc((100% - 4px * (var(--qn-per-row-m, 4.5) - 1)) / var(--qn-per-row-m, 4.5));
    }
    .apgo-qn__link { gap: 8px; }
    .apgo-qn__icon {
      width: var(--qn-icon-m, 56px);
      height: var(--qn-icon-m, 56px);
    }
    .apgo-qn__label { font-size: 12.5px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APGO · 圖示選單",
  "tag": "section",
  "class": "apgo-qn-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "paragraph",
      "content": "一排圓形圖示＋文字，每一格可設連結。放不下時可以左右滑（電腦版會出現左右箭頭）。放在 Banner 輪播正下方，會往上壓進 banner 底部。"
    },
    { "type": "header", "content": "壓在 Banner 上" },
    {
      "type": "range",
      "id": "overlap",
      "label": "電腦版：往上壓進 banner（px）",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 28,
      "info": "0 = 不壓，排在 banner 下方。banner 底部的圓點會自動往上移，不會被蓋住。"
    },
    {
      "type": "range",
      "id": "overlap_mobile",
      "label": "手機：往上壓進 banner（px）",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 12
    },
    { "type": "header", "content": "版面" },
    { "type": "range", "id": "max_width", "label": "卡片最大寬度（px）", "min": 800, "max": 1600, "step": 20, "default": 1440 },
    { "type": "range", "id": "side_padding", "label": "電腦版左右邊距（px）", "min": 0, "max": 60, "step": 2, "default": 16 },
    { "type": "range", "id": "side_padding_mobile", "label": "手機左右邊距（px）", "min": 0, "max": 32, "step": 2, "default": 12 },
    { "type": "range", "id": "gap_bottom", "label": "電腦版下方間距（px）", "min": 0, "max": 80, "step": 2, "default": 28 },
    { "type": "range", "id": "gap_bottom_mobile", "label": "手機下方間距（px）", "min": 0, "max": 60, "step": 2, "default": 16 },
    { "type": "range", "id": "icon_size", "label": "電腦版圖示大小（px）", "min": 48, "max": 110, "step": 2, "default": 76 },
    { "type": "range", "id": "icon_size_mobile", "label": "手機圖示大小（px）", "min": 40, "max": 80, "step": 2, "default": 56 },
    {
      "type": "range",
      "id": "per_row_mobile",
      "label": "手機一排顯示幾格",
      "min": 3,
      "max": 6,
      "step": 0.5,
      "default": 4.5,
      "info": "用 .5 時最右邊會露出半格，提示可以往右滑。"
    },
    { "type": "header", "content": "外觀" },
    { "type": "color", "id": "card_bg", "label": "卡片底色", "default": "#17191d" },
    { "type": "color", "id": "card_border", "label": "卡片邊框", "default": "#2a2d33" },
    { "type": "color", "id": "text_color", "label": "文字顏色", "default": "#e9e9ec" },
    { "type": "color", "id": "hover_color", "label": "滑過時文字顏色", "default": "#f08418" },
    {
      "type": "checkbox",
      "id": "crop_circle",
      "label": "圖示裁成圓形（去掉方形白底）",
      "default": true,
      "info": "圖片若本身就是滿版或透明底，可以關掉。"
    },
    { "type": "text", "id": "aria_label", "label": "無障礙標籤", "default": "商品分類" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "圖示",
      "settings": [
        { "type": "text", "id": "label", "label": "文字", "default": "分類名稱" },
        { "type": "url", "id": "link", "label": "連結" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "圖示圖片",
          "info": "建議正方形、至少 256×256。有上傳就用這張，沒上傳就用下面的內建圖示。"
        },
        {
          "type": "select",
          "id": "builtin",
          "label": "內建圖示",
          "options": [
            { "value": "none", "label": "不使用" },
            { "value": "coating", "label": "汽車（鍍膜）" },
            { "value": "gift", "label": "禮盒（禮組）" },
            { "value": "home", "label": "房子（居家清潔）" },
            { "value": "carcare", "label": "水滴（汽車清潔）" },
            { "value": "repair", "label": "盾牌（損傷修復）" },
            { "value": "tools", "label": "刷子（洗車工具）" },
            { "value": "speed", "label": "儀表（測速器）" },
            { "value": "promo", "label": "大聲公（優惠活動）" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "APGO · 圖示選單",
      "blocks": [
        { "type": "item", "settings": { "label": "鍍膜系列", "builtin": "coating" } },
        { "type": "item", "settings": { "label": "超值禮組", "builtin": "gift" } },
        { "type": "item", "settings": { "label": "居家清潔", "builtin": "home" } },
        { "type": "item", "settings": { "label": "汽車清潔用品", "builtin": "carcare" } }
      ]
    }
  ]
}
{% endschema %}
