    "brand_story_section_axtbQR": {
      "type": "brand-story-section",
      "blocks": {
        "timeline_item_qWD8we": {
          "type": "timeline_item",
          "settings": {
            "year": "2007",
            "icon": "💻",
            "milestone_title": "電子開發起家",
            "description": "從電子開發與行車紀錄器代工開始，創辦人累積了十年的研發與製造經驗，成為台灣各大知名品牌的幕後推手，奠定了對品質執著的基因。"
          }
        },
        "timeline_item_x8L7b3": {
          "type": "timeline_item",
          "settings": {
            "year": "2011",
            "icon": "🏭",
            "milestone_title": "成立行車紀錄器工廠",
            "description": "建立專業工廠，通過ISO9001認證，從設計到生產一條龍服務。得到威剛、聲寶、亞旭科技、愛國者等大廠青睞，甚至承接新加坡國防部訂單。"
          }
        },
        "timeline_item_BBrNae": {
          "type": "timeline_item",
          "settings": {
            "year": "2014",
            "icon": "🚗",
            "milestone_title": "研發第一代洗車鍍膜",
            "description": "創辦人以愛車人士的角度，開始研發洗車鍍膜產品。希望讓每個人都能自己照顧愛車，體驗DIY的樂趣，不再花冤枉錢。"
          }
        },
        "timeline_item_B36GA9": {
          "type": "timeline_item",
          "settings": {
            "year": "2017",
            "icon": "🚀",
            "milestone_title": "APGO品牌誕生",
            "description": "APGO以創辦人之名正式誕生！秉持電子工廠的嚴格規格，所有生產原料及製作流程都經過嚴格把關，立志成為全台最大的鍍膜生產工廠。"
          }
        },
        "timeline_item_McT3jW": {
          "type": "timeline_item",
          "settings": {
            "year": "2019",
            "icon": "🌏",
            "milestone_title": "進軍國際市場",
            "description": "第一代水鍍膜正式上市，同時成立馬來西亞公司，開始拓展東南亞市場。從台灣走向世界，讓更多人體驗APGO的優質產品。"
          }
        },
        "timeline_item_drNKJL": {
          "type": "timeline_item",
          "settings": {
            "year": "2021",
            "icon": "⭐",
            "milestone_title": "產品全面升級",
            "description": "第二代原子鍍膜系列全新升級，新增前置作業及車內保養系列。同年成立新加坡公司，並獲得知名KOL酷炫、Joeman大力推薦。"
          }
        },
        "timeline_item_Bm7TKB": {
          "type": "timeline_item",
          "settings": {
            "year": "2022",
            "icon": "🏆",
            "milestone_title": "媒體認證肯定",
            "description": "知名汽車節目主持人廖盈婷大力推薦，知名KOL廖老大聯名推出原子釉。品牌影響力持續擴大，成為汽車美容界的領導品牌。"
          }
        },
        "timeline_item_YiiRri": {
          "type": "timeline_item",
          "settings": {
            "year": "2024",
            "icon": "🚀",
            "milestone_title": "銷售里程碑",
            "description": "年銷售突破5萬組，成為東南亞知名鍍膜品牌。從零基礎的家庭主婦到專業鍍膜玩家，都能輕鬆上手，讓汽車美容走進每個家庭。"
          }
        }
      },
